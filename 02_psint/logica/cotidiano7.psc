Algoritmo cotidiano7
	Definir num1 Como Entero;
	Escribir 'Ingrese un numero';
	Leer num1;
	Escribir ' ';
	Si num1 == 0
		Escribir 'El numero es Cero';
	SiNo
		Si num1 es negativo
			Escribir 'El numero es negativo';
		SiNo
			Escribir 'El numero es positivo';
		FinSi
	FinSi

FinAlgoritmo
